#for loops have a very important purpose in indexing

my_list = [10, 1, 8, 3, 5]
total = 0

for i in my_list:
    total += i

print(total)

#this snippet adds together each of the indexes and prints the total
#line 38 shows how python automatically handles dynamic list sizes
#instead needing to write "for i in range(len(my_list)):" and the var
#'i' serves the dual purpose of storing the indices value in the list
#to add to the total


