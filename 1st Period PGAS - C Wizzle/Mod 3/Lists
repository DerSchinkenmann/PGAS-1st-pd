list_1 = [1]
list_2 = list_1
list_1[0] = 2
print(list_2)

#this shows how if you were to set list_2 equal to list_1, it just
#makes their names(and memory location) the same. this means that it
#doesnt copy the contents of the list, but makes it so any operation
#done to list_2 is also done to list_1


list_1 = [1]
list_2 = list_1[:]
list_1[0] = 2
print(list_2)

#this is how you would copy the contents, not just change the name.
#the colon is a slice, which makes a new copy of a list(or parts of it)
#my_list[start:end] is the general form of it. if no start is set, it
#defaults to the first element in the list, otherwise it uses the index

#another thing you can do with the slice is delete the contents of a
#list, but not the list itself. usually running del my_list would del
#the memory location and free up the name of the list, but using the 
#slice would just delete the contents of the list

my_list = [0, 3, 12, 8, 2]

print(5 in my_list)
print(5 not in my_list)
print(12 in my_list)

